// ===================== main3.go =====================
// Introdução aos canais: worker envia uma mensagem, main recebe.
// Also demonstra canal unidirecional, canal bufferizado e envio de
// vários valores, conforme pedido ao longo da seção.
package main

import "fmt"

// worker só pode enviar no canal (canal unidirecional de envio)
func worker(c chan<- string) {
	c <- "Olá da goroutine"
}

// produtor envia 5 números em sequência pelo canal
func produtor(c chan<- int) {
	for i := 1; i <= 5; i++ {
		c <- i
	}
}

func main() {
	// Canal não bufferizado: quem envia espera quem recebe, e vice-versa
	canal := make(chan string)
	go worker(canal)
	mensagem := <-canal
	fmt.Println(mensagem)

	// Canal bufferizado: permite até 3 valores sem bloquear o envio
	bufferizado := make(chan int, 3)
	bufferizado <- 10
	bufferizado <- 20
	bufferizado <- 30
	fmt.Println(<-bufferizado, <-bufferizado, <-bufferizado)

	// Enviando vários valores por um canal unidirecional
	numeros := make(chan int)
	go produtor(numeros)
	for i := 1; i <= 5; i++ {
		fmt.Println(<-numeros)
	}
}


// ===================== main4.go =====================
// Dois produtores compartilhando o mesmo canal. Exatamente como no
// PDF: cada produtor envia 5 mensagens (2 x 5 = 10), então a main
// simplesmente recebe 10 vezes, sem close e sem WaitGroup.
package main

import (
	"fmt"
	"time"
)

func produtor(nome string, c chan<- string) {
	for i := 1; i <= 5; i++ {
		c <- fmt.Sprintf("%s -> %d", nome, i)
		time.Sleep(500 * time.Millisecond)
	}
}

func main() {
	canal := make(chan string)
	go produtor("A", canal)
	go produtor("B", canal)

	for i := 0; i < 10; i++ {
		fmt.Println(<-canal)
	}
}


// ===================== main5.go =====================
// Pipeline concorrente: Gerador -> Quadrado -> Impressão
package main

import "fmt"

func geraNumeros(c chan int) {
	for i := 1; i <= 5; i++ {
		c <- i
	}
	close(c)
}

func quadrado(entrada chan int, saida chan int) {
	for n := range entrada {
		saida <- n * n
	}
	close(saida)
}

func main() {
	entrada := make(chan int)
	saida := make(chan int)

	go geraNumeros(entrada)
	go quadrado(entrada, saida)

	for resultado := range saida {
		fmt.Println(resultado)
	}
}


// ===================== main6.go =====================
// Exercício do lab: sistema de monitoramento com dois sensores de
// temperatura (produtores) enviando para um canal compartilhado, e um
// consumidor que calcula quantidade de medições, média, maior e menor
// temperatura.
//
// Seguindo estritamente o padrão do PDF (igual ao main4.go): como
// sabemos exatamente quantas leituras vêm no total (2 sensores x 100
// leituras = 200), o consumidor simplesmente recebe 200 vezes num
// for, sem usar close() nem sync.WaitGroup.
package main

import (
	"fmt"
	"math/rand"
	"time"
)

// sensor gera 100 temperaturas aleatórias entre 0 e 60, aguarda um
// intervalo entre as medições e envia cada leitura ao canal
// compartilhado. c é um canal somente de envio (unidirecional).
func sensor(nome string, c chan<- float64) {
	for i := 0; i < 100; i++ {
		temperatura := rand.Float64() * 60 // 0.0 a 60.0
		c <- temperatura
		time.Sleep(10 * time.Millisecond)
	}
}

func main() {
	canal := make(chan float64)

	// dois sensores de temperatura (produtores) compartilhando o canal
	go sensor("Sensor A", canal)
	go sensor("Sensor B", canal)

	totalLeituras := 200 // 2 sensores x 100 leituras cada
	quantidade := 0
	var soma, maior, menor float64

	for i := 0; i < totalLeituras; i++ {
		temperatura := <-canal
		quantidade++
		soma += temperatura

		if quantidade == 1 {
			maior = temperatura
			menor = temperatura
		} else {
			if temperatura > maior {
				maior = temperatura
			}
			if temperatura < menor {
				menor = temperatura
			}
		}
	}

	media := soma / float64(quantidade)

	fmt.Println("--- Relatório do monitoramento ---")
	fmt.Printf("Quantidade de medições: %d\n", quantidade)
	fmt.Printf("Temperatura média:      %.2f\n", media)
	fmt.Printf("Maior temperatura:      %.2f\n", maior)
	fmt.Printf("Menor temperatura:      %.2f\n", menor)
}
